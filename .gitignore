.agents/skills/*/report.json

# Dispatcher-based command surface (Make SSOT)
!scripts/
!scripts/cmd/
!scripts/cmd/**
scripts/*.py
scripts/*.sh
scripts/*.md
!scripts/dispatch.py
!scripts/__init__.py

# Python configuration
!pyproject.toml
!.taplo.toml
!pyrefly.toml
!poetry.lock
!uv.lock
