
      # Cross-repo private git dependencies: the workflow token is scoped to
      # this repository only, so `uv sync` cannot clone sibling private repos
      # (make setup fails inside the git dependency fetch). When the org
      # installs the datacosmos-ci-dependencies GitHub App and exposes
      # CI_DEPENDENCIES_APP_ID / CI_DEPENDENCIES_APP_PRIVATE_KEY, mint a
      # short-lived installation token and scope it to github.com clones.
      # Absent secrets make this step a recorded NOT EXECUTED: dependency
      # access then remains the repository's own contract, and the external
      # credential gate is not selected on this runner.
      - name: Mint cross-repo dependency credential
        env:
          CI_DEPS_APP_ID: ${{ secrets.CI_DEPENDENCIES_APP_ID }}
          CI_DEPS_APP_KEY: ${{ secrets.CI_DEPENDENCIES_APP_PRIVATE_KEY }}
        run: |
          set -euo pipefail
          if [ -z "$CI_DEPS_APP_ID" ] || [ -z "$CI_DEPS_APP_KEY" ]; then
            echo "NOT EXECUTED: CI_DEPENDENCIES_* secrets absent, no cross-repo credential minted"
            exit 0
          fi
          identity_root="$RUNNER_TEMP/flext-cross-repo-deps"
          install -d -m 700 "$identity_root"
          key_path="$identity_root/app-key.pem"
          printf '%s\n' "$CI_DEPS_APP_KEY" > "$key_path.new"
          chmod 600 "$key_path.new"
          mv "$key_path.new" "$key_path"
          b64url() {
            openssl base64 -A | tr '+/' '-_' | tr -d '='
          }
          now=$(date +%s)
          header='{"alg":"RS256","typ":"JWT"}'
          payload=$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$CI_DEPS_APP_ID")
          input="$(printf %s "$header" | b64url).$(printf %s "$payload" | b64url)"
          signature=$(printf %s "$input" | openssl dgst -sha256 -sign "$key_path" | b64url)
          jwt="$input.$signature"
          installation_id=$(curl -sfS -X GET \
            -H "Authorization: Bearer $jwt" \
            -H "Accept: application/vnd.github+json" \
            https://api.github.com/app/installations \
            | python3 -c 'import json, sys
          entries = json.load(sys.stdin)
          if len(entries) != 1:
              sys.exit(f"expected exactly one app installation, got {len(entries)}")
          print(entries[0]["id"])')
          access_token=$(curl -sfS -X POST \
            -H "Authorization: Bearer $jwt" \
            -H "Accept: application/vnd.github+json" \
            "https://api.github.com/app/installations/$installation_id/access_tokens" \
            | python3 -c 'import json, sys; print(json.load(sys.stdin)["token"])')
          echo "::add-mask::$access_token"
          git config --global url."https://x-access-token:${access_token}@github.com/".insteadOf "https://github.com/"
          rm -f "$key_path"
