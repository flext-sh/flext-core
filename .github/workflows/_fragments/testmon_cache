
      - name: Restore testmon cache
        id: testmon-restore
        uses: actions/cache@v6
        with:
          path: |
            ${{ github.workspace }}/../.flext-runtime/*/testmon/.testmondata
          key: testmon-v1-${{ runner.os }}-${{ runner.arch }}-py3.13-${{ hashFiles('pyproject.toml', '**/pyproject.toml') }}-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: |
            testmon-v1-${{ runner.os }}-${{ runner.arch }}-py3.13-${{ hashFiles('pyproject.toml', '**/pyproject.toml') }}-
            testmon-v1-${{ runner.os }}-${{ runner.arch }}-py3.13-
