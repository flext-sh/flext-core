#!/home/marlonsc/flext-work/flext-core-gov/.venv/bin/python3
# -*- coding: utf-8 -*-
import sys
from flext_infra.cli import docs_main
if __name__ == "__main__":
    if sys.argv[0].endswith("-script.pyw"):
        sys.argv[0] = sys.argv[0][:-11]
    elif sys.argv[0].endswith(".exe"):
        sys.argv[0] = sys.argv[0][:-4]
    sys.exit(docs_main())
