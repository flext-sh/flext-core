name: CI

# === SECTION: triggers (managed) ===
# Source: operator CI policy — integration push/PR = blocking CI only;
# main push/PR (non-draft) = blocking CI; draft and other branches = none.
"on":
  push:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
  pull_request:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
    types: [opened, synchronize, reopened, ready_for_review]
# End SECTION: triggers

# Why: one active run per workflow and branch prevents obsolete CI from consuming runners.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  # === SECTION: ci job (managed) ===
  # Source: template + config:github_actions.*
  ci:
    name: ci
    # Only the checkout job needs repository contents.
    permissions:
      contents: read
    if: {% raw %}${{ github.event_name != 'pull_request' || github.event.pull_request.draft == false }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          fetch-depth: 0
{%- include "_fragments/private_submodules_init.j2" %}
      # Mise resolves GitHub credentials only through the declared command
      # (never a token in the environment). The Mise transaction strips the
      # inherited environment, so on a runner that command reads the job's own
      # token from a 0600 file outside the checkout. The `runner` context is
      # unavailable in job-level `env`, so the resolved command is exported to
      # the following steps through GITHUB_ENV.
      - name: Declare the Mise GitHub credential source
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          install -m 600 /dev/null "$RUNNER_TEMP/mise-github-token"
          printf '%s' "$GITHUB_TOKEN" > "$RUNNER_TEMP/mise-github-token"
          echo "MISE_GITHUB_CREDENTIAL_COMMAND=cat $RUNNER_TEMP/mise-github-token" >> "$GITHUB_ENV"

      # make setup is the only toolchain installer. Its committed Mise seed
      # resolves and executes the newest signed Mise release, then installs the
      # exact tool versions recorded in mise.lock before any other Make verb.

      # The direnv check gate runs a real `direnv exec` activation smoke. The
      # preinstalled runner image has no direnv binary, so provision it here —
      # the gate is intentional and its binary must exist wherever CI=Y make
      # check runs. The smoke runs unattended, where no one can answer
      # `direnv allow`, so allow the checkout's .envrc up front: `direnv allow
      # <path>` computes and stores the same path-hash record an interactive
      # allow writes. .envrc is tracked, so it exists right after checkout.
      # This trusts only this repo's own generated file, on this runner only.
      - name: Install direnv (check-gate dependency)
        run: |
          sudo apt-get update -qq && sudo apt-get install -y -qq direnv
          direnv allow "{% raw %}${{ github.workspace }}{% endraw %}/.envrc"
{%- if system_packages %}

      # Why: this repository's tests exercise a real external engine, and the
      # fleet declares such runner packages per distribution (codegen
      # ci_system_packages) instead of skipping the tests that need them.
      - name: Install declared system packages
        run: sudo apt-get install -y -qq --no-install-recommends {{ system_packages | join(" ") }}
{%- endif %}

{%- include "_fragments/testmon_cache.j2" %}

{%- for step in make.workflow if "ci" in step.contexts %}
      - name: {{ step.verb }} (blocking)
        # Why (flext-v4p5): explicit CI=Y on every make invocation (job env is not enough for matrix/docker parity).
        run: {{ make.ci.variable }}={{ make.ci.value }} make {{ step.verb }}{% if step.apply %} WHAT=apply {{ make.apply_variable }}={{ make.apply_value }}{% endif %}
{%- if step.verb == "setup" %}
      - name: gen check (blocking)
        run: {{ make.ci.variable }}={{ make.ci.value }} make gen WHAT=check

      # Setup installs the committed lock as-is (`uv sync --frozen`); a stale
      # lock is a reviewed change through `make deps`, so CI proves it here
      # instead of letting a runner rewrite it.
      - name: deps check (blocking)
        run: {{ make.ci.variable }}={{ make.ci.value }} make deps
{%- endif %}
{%- if step.verb == "check" %}

      # Why (aihub-v01jg): {{ make.ci.variable }}={{ make.ci.value }} runs ONE HALF of the gate set
      # ({{ make.ci.check_gates | join(" ") }}); the complement
      # ({{ make.ci.local_check_gates | join(" ") }}) is owned by
      # {{ make.ci.variable }}={{ make.ci.local_value }} and, without this step, ran on developer
      # machines only. That split let real defects reach main twice: five
      # missing-attribute errors and an inconsistent-inheritance error, each
      # green in CI and red locally. The two contexts are strict complements by
      # construction, so running both here costs one extra pass and closes the
      # hole rather than trusting everyone to run the other half by hand.
      - name: {{ step.verb }} complement (blocking)
        run: {{ make.ci.variable }}={{ make.ci.local_value }} make {{ step.verb }}
{%- endif %}
{% endfor %}
      - name: Dump reports on failure
        if: {% raw %}${{ failure() }}{% endraw %}
        run: |
          set -eu
          # Structured reports only — same allowlist as Upload reports (no raw
          # pytest/tool logs: those may carry connection strings / env secrets).
          for report_root in .reports apps; do
            if [ -d "$report_root" ]; then
              find "$report_root" \
                \( -path '*/junit.xml' -o -path '*/coverage.xml' -o -path '*/coverage.json' \) \
                -type f -exec sh -eu -c '
                  for report_file do
                    printf "::group::%s\n" "$report_file"
                    tail -n 200 "$report_file"
                    printf "::endgroup::\n"
                  done
                ' sh {} +
            fi
          done
      - name: Upload reports on failure
        if: {% raw %}${{ failure() }}{% endraw %}
        uses: {{ github_actions["upload-artifact"].repository }}@{{ github_actions["upload-artifact"].sha }}  # {{ github_actions["upload-artifact"].version }}
        with:
          name: flext-ci-reports-{% raw %}${{ github.run_id }}{% endraw %}
          # Structured reports only — omit raw pytest/tool logs that may carry
          # connection strings or env-derived secrets from integration fixtures.
          path: |
            .reports/**/junit.xml
            .reports/**/coverage.xml
            .reports/**/coverage.json
            apps/*/.reports/**/junit.xml
            apps/*/.reports/**/coverage.xml
            apps/*/.reports/**/coverage.json
          if-no-files-found: ignore
          retention-days: 7
  # End SECTION: ci job

  # === SECTION: release-plan job (managed) ===
  # The release protocol's read-only decision on every pull request: the title
  # must be a Conventional Commits title (it becomes the merge commit subject
  # the next release is derived from), and no pyproject version may change
  # outside the protocol's own release commit.
  release-plan:
    name: release-plan
    permissions:
      contents: read
    if: {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.draft == false }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          fetch-depth: 0
          submodules: {{ checkout_submodules }}
{%- include "_fragments/private_submodules_init.j2" %}
      - name: Boot
        run: make setup
      - name: Release plan and guard
        env:
          PR_TITLE: {% raw %}${{ github.event.pull_request.title }}{% endraw %}
        run: make release WHAT=plan PR_TITLE="$PR_TITLE"
  # End SECTION: release-plan job

  # === SECTION: merge-guard job (managed) ===
  merge-guard:
    name: merge-guard
    permissions:
      contents: read
    # Draft is the typed WIP state: no repository Action is selected until the
    # operator promotes the same PR to Review with a non-WIP head.
    if: {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.draft == false }}{% endraw %}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout promoted head
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          fetch-depth: 1
      - name: Block WIP heads from protected integration branches
        env:
          BASE_REF: {% raw %}${{ github.base_ref }}{% endraw %}
        run: |
          set -eu
          case "$BASE_REF" in
            {% for branch in make.work_in_progress.merge_lock_target_branches %}{{ branch }}{% if not loop.last %}|{% endif %}{% endfor %})
              ;;
            *)
              echo "Merge guard passed for $(git rev-parse HEAD) -> $BASE_REF"
              exit 0
              ;;
          esac
          subject=$(git log -1 --format=%s)
          if [[ "$subject" == \[WIP\]* ]]; then
            echo "WIP head cannot merge into ${BASE_REF}: ${subject}"
            exit 1
          fi
          echo "Merge guard passed for $(git rev-parse HEAD) -> $BASE_REF"
  # End SECTION: merge-guard job
