# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
name: CI

"on":
  pull_request:
  push:
    branches:
      - {{ repository_branch }}
  workflow_dispatch:

permissions:
  contents: read

jobs:
  ci:
    name: ci
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - name: Checkout repository
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          fetch-depth: 0

      - name: Setup
        run: make setup

      - name: Check
        run: make check

      - name: Test
        run: make test
