{%- set public_exports = [class_stem, class_stem ~ "Constants", class_stem ~ "Models", class_stem ~ "Protocols", class_stem ~ "Service", class_stem ~ "Types", class_stem ~ "Utilities", "c", "config", "m", "p", alias, "s", "settings", "t", "u"] + inherited_facets -%}
{%- set public_export_rows = '    "' ~ (public_exports | sort(case_sensitive=true) | join('",\n    "')) ~ '",' -%}
{%- macro facade_import(module_name, export_name, export_alias) -%}
{%- set compact = "    from " ~ package_name ~ "." ~ module_name ~ " import " ~ export_name ~ " as " ~ export_name ~ ", " ~ export_alias ~ " as " ~ export_alias -%}
{%- set expanded = "    from " ~ package_name ~ "." ~ module_name ~ " import (\n        " ~ export_name ~ " as " ~ export_name ~ ",\n        " ~ export_alias ~ " as " ~ export_alias ~ ",\n    )" -%}
{{- compact if compact | length <= tooling.tools.ruff.line_length else expanded -}}
{%- endmacro -%}
"""{{ class_stem }} package — canonical lazy public facade.

The package root freezes this facade as the stable user entrypoint. Consumers
import ``{{ class_stem }}`` or ``{{ alias }}`` from ``{{ package_name }}`` and
reach domain concerns through canonical aliases and namespaces.

