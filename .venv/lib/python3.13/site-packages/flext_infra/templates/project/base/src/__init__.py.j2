SPDX-License-Identifier: MIT
"""

from __future__ import annotations

from types import MappingProxyType
from typing import TYPE_CHECKING

from flext_core.lazy import build_lazy_import_map, install_lazy_exports

if TYPE_CHECKING:
    # NOTE (multi-agent, flext-j47u): all public objects stay lazy at runtime.
{% for facet in inherited_facets %}
    from {{ upstream }} import {{ facet }} as {{ facet }}
{% endfor %}

    from {{ package_name }}._config import config as config
    from {{ package_name }}._settings import settings as settings
{{ facade_import("api", class_stem, alias) }}
{{ facade_import("base", class_stem ~ "Service", "s") }}
{{ facade_import("constants", class_stem ~ "Constants", "c") }}
{{ facade_import("models", class_stem ~ "Models", "m") }}
{{ facade_import("protocols", class_stem ~ "Protocols", "p") }}
{{ facade_import("typings", class_stem ~ "Types", "t") }}
{{ facade_import("utilities", class_stem ~ "Utilities", "u") }}

__all__: tuple[str, ...] = (
{{ public_export_rows }}
)


_LAZY_IMPORTS = MappingProxyType(
    build_lazy_import_map(
        MappingProxyType({
            ".api": ("{{ class_stem }}", "{{ alias }}"),
            ".base": ("{{ class_stem }}Service", "s"),
            ".constants": ("{{ class_stem }}Constants", "c"),
            ".models": ("{{ class_stem }}Models", "m"),
            ".protocols": ("{{ class_stem }}Protocols", "p"),
            "._config": ("config",),
            "._settings": ("settings",),
            ".typings": ("{{ class_stem }}Types", "t"),
            ".utilities": ("{{ class_stem }}Utilities", "u"),
{% if inherited_facets %}
            "{{ upstream }}": ({% for facet in inherited_facets %}"{{ facet }}", {% endfor %}),
{% endif %}
        }),
        alias_groups=MappingProxyType({}),
        sort_keys=False,
    )
)

install_lazy_exports(
    __name__,
    globals(),
    _LAZY_IMPORTS,
    public_exports=__all__,
)
