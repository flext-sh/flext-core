# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
#
# Release protocol projection. The workflow selects which protocol phase to
# run; every decision (next version, guard, tag identity, receipt, upload set)
# is made by `make release`, never here.
#
# - A push to the integration branch whose head is NOT the protocol's release
#   commit opens or updates the release pull request (`make release
#   WHAT=version APPLY=Y`); when nothing is releasable the run is a no-op.
# - A push whose head IS the release commit (the merged release pull request)
#   tags it, builds the receipt and publishes exactly what the receipt attests.
# - `workflow_dispatch` re-runs build and publication for an existing tag.
name: Release

"on":
  push:
    branches:
      - {{ repository_branch }}
  workflow_dispatch:
    inputs:
      tag:
        description: "Existing release tag to build and publish again (example: v0.12.0)"
        required: true
        type: string

concurrency:
  group: release-{% raw %}${{ github.ref_name }}{% endraw %}
  cancel-in-progress: false

permissions: {}

jobs:
  identity:
    name: Resolve release state
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    outputs:
      release_commit: {% raw %}${{ steps.head.outputs.release_commit }}{% endraw %}
      ref: {% raw %}${{ steps.head.outputs.ref }}{% endraw %}
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          fetch-depth: 1
          persist-credentials: false
          ref: {% raw %}${{ github.event_name == 'workflow_dispatch' && format('refs/tags/{0}', inputs.tag) || github.sha }}{% endraw %}
      - name: Classify HEAD
        id: head
        env:
          EVENT_NAME: {% raw %}${{ github.event_name }}{% endraw %}
          DISPATCH_TAG: {% raw %}${{ inputs.tag }}{% endraw %}
        shell: bash
        run: |
          set -euo pipefail
          subject="$(git log -1 --format=%s)"
          if [ "$EVENT_NAME" = "workflow_dispatch" ]; then
            echo "ref=refs/tags/$DISPATCH_TAG" >> "$GITHUB_OUTPUT"
            echo "release_commit=true" >> "$GITHUB_OUTPUT"
          else
            echo "ref=$GITHUB_SHA" >> "$GITHUB_OUTPUT"
            case "$subject" in
              "chore(release): v"*) echo "release_commit=true" >> "$GITHUB_OUTPUT" ;;
              *) echo "release_commit=false" >> "$GITHUB_OUTPUT" ;;
            esac
          fi

  version:
    name: Open or update the release pull request
    needs: identity
    if: needs.identity.outputs.release_commit == 'false'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    permissions:
      contents: write # Push the release/next lane.
      pull-requests: write # Open or update the release pull request.
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
      # A pull request opened with the default GITHUB_TOKEN triggers no CI, so
      # the release PR would reach merge unvalidated (flext-1wjg1.16.5). The
      # lane push and the PR use the organization automation token; when that
      # secret is absent the job fails loud instead of degrading silently.
      GH_TOKEN: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}
    steps:
      - name: Require the release automation token
        run: |
          if [ -z "${GH_TOKEN:-}" ]; then
            echo "::error::secrets.RELEASE_TOKEN is not configured: a release pull request opened with GITHUB_TOKEN triggers no CI. Configure the organization secret and rerun." >&2
            exit 1
          fi
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          fetch-depth: 0
          submodules: {{ checkout_submodules }}
          token: {% raw %}${{ secrets.RELEASE_TOKEN }}{% endraw %}
{%- include "_fragments/private_submodules_init.j2" %}
      - name: Release identity
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
      - name: Boot
        run: make setup
      - name: Release pull request
        run: make release WHAT=version {{ make.apply_variable }}={{ make.apply_value }}

  publish:
    name: Tag, build and publish the release commit
    needs: identity
    if: needs.identity.outputs.release_commit == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 180
    permissions:
      contents: write # Push the release tag and create the GitHub release.
{%- if make_profile == "workspace" %}
      id-token: write # Trusted publishing to the package index.
    environment: pypi
{%- endif %}
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
      GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
    steps:
      - name: Checkout release commit
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          fetch-depth: 0
          ref: {% raw %}${{ needs.identity.outputs.ref }}{% endraw %}
          submodules: {{ checkout_submodules }}
{%- include "_fragments/private_submodules_init.j2" %}
      - name: Release identity
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
      - name: Boot
        run: make setup
      - name: Tag
        run: make release WHAT=tag {{ make.apply_variable }}={{ make.apply_value }}
      - name: Build receipt
        run: make release WHAT=build
      - name: Publish
        run: make release WHAT=publish {{ make.apply_variable }}={{ make.apply_value }}{% if make_profile == "workspace" %} INDEX=Y{% endif %}
