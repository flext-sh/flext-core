# Generated initially by `flext-infra codegen new`; this manifest is the
# handwritten topology SSOT consumed by `flext-infra codegen conform`.
# NOTE (multi-agent, mro-wkii.17 / agent: codex): conform never overwrites this
# input. Add members or exclusions here, then run `make gen`.
version: {{ workspace_manifest_version }}
name: {{ dist }}
repository:
  name: {{ dist }}
  distribution: {{ dist }}
  provider: {{ repository_provider }}
  url: {{ repository_git_url }}
  path: .
  role: {{ workspace_repository.role | tojson }}
  state: active
  checkout: {{ workspace_repository.checkout | tojson }}
  codegen: {{ workspace_repository.codegen | tojson }}
  package: {{ workspace_repository.package | tojson }}
  editable: {{ workspace_repository.editable | tojson }}
  read_only: {{ workspace_repository.read_only | tojson }}
{%- if workspace_repository.uv_link_mode %}
  uv_link_mode: {{ workspace_repository.uv_link_mode | tojson }}
{%- endif %}
{%- if workspace_repository.dependency_cooldown_exclusions %}
  dependency_cooldown_exclusions: {{ workspace_repository.dependency_cooldown_exclusions | list | tojson }}
{%- endif %}
{%- if workspace_repository.dependency_cooldown_overrides %}
  dependency_cooldown_overrides:
{%- for package, cutoff in workspace_repository.dependency_cooldown_overrides.items() %}
    {{ package | tojson }}: {{ cutoff | tojson }}
{%- endfor %}
{%- endif %}
{%- if workspace_repository.extra_verbs %}
  extra_verbs:
{%- for verb in workspace_repository.extra_verbs %}
    - name: {{ verb.name | tojson }}
      default_what: {{ verb.default_what | tojson }}
      whats: {{ verb.whats | tojson }}
      apply_guarded: {{ verb.apply_guarded | tojson }}
{%- endfor %}
{%- endif %}
{%- if workspace_repository.script_dispatch %}
  script_dispatch:
    dispatcher: {{ workspace_repository.script_dispatch.dispatcher | tojson }}
    roots:
{%- for root in workspace_repository.script_dispatch.roots %}
      - {{ root | tojson }}
{%- endfor %}
{%- endif %}
project:
  package_name: {{ package_name | tojson }}
  class_stem: {{ class_stem | tojson }}
  namespace: {{ ns | tojson }}
  constant_name: {{ const_name | tojson }}
  namespace_attribute: {{ ns_attr | tojson }}
  alias: {{ alias | tojson }}
  environment_prefix: {{ env_prefix | tojson }}
  description: {{ description | tojson }}
  license: {{ license | tojson }}
  author_name: {{ author_name | tojson }}
  author_email: {{ author_email | tojson }}
  upstream: {{ upstream | tojson }}
  inherited_facets: {{ inherited_facets | list | tojson }}
  homepage: {{ homepage | tojson }}
  documentation: {{ documentation | tojson }}
  runtime_root_rel: {{ runtime_root_rel | tojson }}
  year: {{ year }}
# NOTE (multi-agent, mro-wkii.17 / agent: codex): the typed manifest context is
# the sole topology owner; every declared member/exclusion round-trips here.
{%- if workspace_integration %}
integration:
  provider: {{ workspace_integration.provider | tojson }}
  branch: {{ workspace_integration.branch | tojson }}
{%- if workspace_integration.organization %}
  organization: {{ workspace_integration.organization | tojson }}
{%- endif %}
{%- if workspace_integration.base_url %}
  base_url: {{ workspace_integration.base_url | tojson }}
{%- endif %}
{%- endif %}
members:
{% for repository in workspace_repositories %}
  - name: {{ repository.name | tojson }}
    distribution: {{ repository.distribution | tojson }}
    provider: {{ repository.provider | tojson }}
    url: {{ repository.url | tojson }}
    path: {{ repository.path | tojson }}
    role: {{ repository.role | tojson }}
    state: {{ repository.state | tojson }}
    checkout: {{ repository.checkout | tojson }}
    codegen: {{ repository.codegen | tojson }}
    package: {{ repository.package | tojson }}
    editable: {{ repository.editable | tojson }}
    read_only: {{ repository.read_only | tojson }}
{%- if repository.uv_link_mode %}
    uv_link_mode: {{ repository.uv_link_mode | tojson }}
{%- endif %}
{%- if repository.dependency_cooldown_exclusions %}
    dependency_cooldown_exclusions: {{ repository.dependency_cooldown_exclusions | list | tojson }}
{%- endif %}
{%- if repository.dependency_cooldown_overrides %}
    dependency_cooldown_overrides:
{%- for package, cutoff in repository.dependency_cooldown_overrides.items() %}
      {{ package | tojson }}: {{ cutoff | tojson }}
{%- endfor %}
{%- endif %}
{%- if repository.extra_verbs %}
    extra_verbs:
{%- for verb in repository.extra_verbs %}
      - name: {{ verb.name | tojson }}
        default_what: {{ verb.default_what | tojson }}
        whats: {{ verb.whats | tojson }}
        apply_guarded: {{ verb.apply_guarded | tojson }}
{%- endfor %}
{%- endif %}
{%- if repository.script_dispatch %}
    script_dispatch:
      dispatcher: {{ repository.script_dispatch.dispatcher | tojson }}
      roots:
{%- for root in repository.script_dispatch.roots %}
        - {{ root | tojson }}
{%- endfor %}
{%- endif %}
{% else %}
  []
{%- endfor %}
repository_policy_overlays:
{% for overlay in workspace_policy_overlays %}
  - project: {{ overlay.project | tojson }}
    beads_enabled: {{ overlay.beads_enabled | tojson }}
    ci_enabled: {{ overlay.ci_enabled | tojson }}
    ci_matrix_auto_run: {{ overlay.ci_matrix_auto_run | tojson }}
{% else %}
  []
{%- endfor %}
exclusions:
{% for exclusion in workspace_exclusions %}
  - path: {{ exclusion.path | tojson }}
    reason: {{ exclusion.reason | tojson }}
{% else %}
  []
{%- endfor %}
