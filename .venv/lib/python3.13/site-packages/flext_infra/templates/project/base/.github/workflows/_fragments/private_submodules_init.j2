{%- if private_submodules %}
          persist-credentials: false

      - name: Init private workspace projects
        env:
{% for key in private_submodules.deploy_keys %}
          {{ key.secret }}: {% raw %}${{ secrets.{% endraw %}{{ key.secret }}{% raw %} }}{% endraw %}
{% endfor %}
        run: |
          set -euo pipefail
          : "${RUNNER_TEMP:?RUNNER_TEMP is required for private submodule identity}"
{% for key in private_submodules.deploy_keys %}
          if [ -z "${{ '{' }}{{ key.secret }}{{ '}' }}" ]; then
            echo "::error::secret {{ key.secret }} missing — private submodule {{ key.path }} requires a read-only deploy key"
            exit 1
          fi
{% endfor %}
          identity_root="$RUNNER_TEMP/flext-private-submodules"
          install -d -m 700 "$identity_root"
          known_hosts="$identity_root/known_hosts"
          printf '%s\n'{% for line in private_submodules.known_hosts %} \
            '{{ line }}'{% endfor %} > "$known_hosts.new"
          chmod 600 "$known_hosts.new"
          mv "$known_hosts.new" "$known_hosts"
{% for key in private_submodules.deploy_keys %}
          key_path="$identity_root/key-{{ "%02d" | format(loop.index0) }}"
          printf '%s\n' "${{ '{' }}{{ key.secret }}{{ '}' }}" > "$key_path.new"
          chmod 600 "$key_path.new"
          mv "$key_path.new" "$key_path"
{% endfor %}
          git submodule sync -- {{ private_submodules.paths | join(" ") }}
{% for key in private_submodules.deploy_keys %}
          key_path="$identity_root/key-{{ "%02d" | format(loop.index0) }}"
          ssh_command="ssh -F none -i \"$key_path\" -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=\"$known_hosts\""
          git config "submodule.{{ key.submodule }}.url" "{{ key.remote }}"
          git -c core.sshCommand="$ssh_command" submodule update --init --depth 1 -- "{{ key.path }}"
          git -C "{{ key.path }}" config --local core.sshCommand "$ssh_command"
          git -C "{{ key.path }}" remote set-url origin "{{ key.remote }}"
{% endfor %}
{%- endif -%}
