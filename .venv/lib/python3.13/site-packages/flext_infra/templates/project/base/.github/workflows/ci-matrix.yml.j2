# Generated by `flext_infra codegen conform` for {{ dist }}.
# === SECTION: header (managed) ===
# Source: template (base/.github/workflows/ci-matrix.yml.j2)
# Free: no
# End SECTION: header
# Multi-environment CI base: proves the project bootstrap and canonical Make
# verbs work identically across distros, macOS, and Windows. The CI invokes
# the project's own Make surface; it never reimplements bootstrap.
# Projected identically for workspace and standalone repositories. Workspace
# projects are covered by the root matrix.
# Never bind triggers to the integration-line variable.
---
name: ci-matrix

# === SECTION: triggers (managed) ===
# Source: static dispatch-only policy; no pull_request or integration-line binding.
"on":
  workflow_dispatch: {}
# End SECTION: triggers


# === SECTION: permissions (managed) ===
# Source: template (minimal read-only permissions)
permissions:
  contents: read
# End SECTION: permissions

# === SECTION: concurrency (managed) ===
# Source: template (one run per workflow+ref)
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true
# End SECTION: concurrency

jobs:
  # === SECTION: distro-matrix (managed) ===
  # Source: template + config:github_actions.checkout (distro list is template literal by design)
  distro-matrix:
    # Clean-machine proof per distro: build the distro image (which runs the
    # full project bootstrap at image-build time), then smoke the verb surface
    # inside the built container.
    runs-on: ubuntu-latest
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
    strategy:
      fail-fast: false
      matrix:
        distro: [ubuntu, debian, fedora, alpine, arch]
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          # No step needs authenticated git after checkout; persisting the
          # token into .git/config would expose it to every later command.
          persist-credentials: false
      - name: Build {% raw %}${{ matrix.distro }}{% endraw %} image
        run: >-
          docker build
          -f tests/fixtures/ci/docker/{% raw %}${{ matrix.distro }}{% endraw %}.Dockerfile
          -t ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %}
          .
      - name: Bootstrap + verb smoke ({% raw %}${{ matrix.distro }}{% endraw %})
        env:
          {{ make.ci.variable }}: {{ make.ci.value }}
        run: |
          docker run --rm -e {{ make.ci.variable }}={{ make.ci.value }} ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} make help
          docker run --rm -e {{ make.ci.variable }}={{ make.ci.value }} ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} make check
          # ci-matrix proves bootstrap + check across distros; it never runs make test.
  # End SECTION: distro-matrix

  # === SECTION: macos (managed) ===
  # Source: template + config:github_actions.checkout + generated Make setup
  macos:
    runs-on: macos-latest
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          # No step needs authenticated git after checkout; persisting the
          # token into .git/config would expose it to every later command.
          persist-credentials: false
      - name: Bootstrap
        run: {{ make.ci.variable }}={{ make.ci.value }} make setup
      - name: Verb surface
        run: {{ make.ci.variable }}={{ make.ci.value }} make help
      # The canonical gate, not just the verb surface: this matrix exists to
      # catch platform-specific failures, and `make help` exercises none of
      # the gates. The linux job already runs it.
      - name: Canonical check
        run: {{ make.ci.variable }}={{ make.ci.value }} make check
  # End SECTION: macos

  # === SECTION: windows (managed) ===
  # Source: template + config:github_actions.checkout + generated Make setup
  windows:
    runs-on: windows-latest
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          # No step needs authenticated git after checkout; persisting the
          # token into .git/config would expose it to every later command.
          persist-credentials: false
      - name: Bootstrap
        shell: bash
        run: {{ make.ci.variable }}={{ make.ci.value }} make setup
      - name: Verb surface
        shell: bash
        run: {{ make.ci.variable }}={{ make.ci.value }} make help
      # The canonical gate, not just the verb surface: this matrix exists to
      # catch platform-specific failures, and `make help` exercises none of
      # the gates. The linux job already runs it.
      - name: Canonical check
        shell: bash
        run: {{ make.ci.variable }}={{ make.ci.value }} make check
# End SECTION: windows
