# === SECTION: repository environment (managed) ===
# Source: computed:nearest-pyproject-via-direnv-find_up + template
PROJECT_ROOT="$(find_up pyproject.toml)" || return $?
case "${PROJECT_ROOT}" in
  /*) ;;
  *) printf 'ERROR: project discovery did not return an absolute manifest path: %s\n' "${PROJECT_ROOT}" >&2; return 2 ;;
esac
PROJECT_ROOT="${PROJECT_ROOT%/*}"
# Physical paths only: the Makefile resolves its roots with realpath and
# `pwd -P`, so a checkout entered through a symlink keeps one runtime path.
PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd -P)" || return $?
# The shared native reader authenticates Git scope and asks governed UV about
# membership. Activation observes the reader; it never provisions it.
GIT_DISCOVERY_ROOT="$( set -eu; \
unset GIT_CEILING_DIRECTORIES; \
git_local_keys="$(git rev-parse --local-env-vars)"; \
for git_local_key in ${git_local_keys}; do \
	case "${git_local_key}" in (GIT_CONFIG|GIT_CONFIG_PARAMETERS|GIT_CONFIG_COUNT) ;; (*) unset "${git_local_key}" ;; esac; \
done; \
project_root="${PROJECT_ROOT}"; \
case "${project_root}" in (/*) ;; (*) printf 'ERROR: workspace discovery requires an absolute project directory: %s\n' "${project_root}" >&2; exit 2 ;; esac; \
project_root="$(cd "${project_root}" && pwd -P)"; \
git_parent="${project_root}"; \
case "${git_parent}" in (/*) ;; (*) printf 'ERROR: Git marker discovery requires an absolute physical directory: %s\n' "${git_parent}" >&2; exit 2 ;; esac; \
while [ "${git_parent}" != / ] && [ ! -e "${git_parent}/.git" ] && [ ! -L "${git_parent}/.git" ]; do \
	next_git_parent="$(dirname "${git_parent}")"; \
	if [ "${next_git_parent}" = "${git_parent}" ]; then printf 'ERROR: Git marker discovery cannot advance from: %s\n' "${git_parent}" >&2; exit 2; fi; \
	git_parent="${next_git_parent}"; \
done; \
if [ -e "${git_parent}/.git" ] || [ -L "${git_parent}/.git" ]; then git -C "${project_root}" rev-parse --resolve-git-dir "${git_parent}/.git" >/dev/null; fi; \
git_root="$(git -C "${project_root}" rev-parse --show-toplevel)"; \
git_root="$(cd "${git_root}" && pwd -P)"; \
case "${project_root}/" in ("${git_root}/"*) ;; (*) printf 'ERROR: physical Git root does not contain this project: %s\n' "${git_root}" >&2; exit 2 ;; esac; \
printf '%s\n' "${git_root}" )"
RUNTIME_ROOT="$( set -eu; \
unset GIT_CEILING_DIRECTORIES; \
git_local_keys="$(git rev-parse --local-env-vars)"; \
for git_local_key in ${git_local_keys}; do \
	case "${git_local_key}" in (GIT_CONFIG|GIT_CONFIG_PARAMETERS|GIT_CONFIG_COUNT) ;; (*) unset "${git_local_key}" ;; esac; \
done; \
project_root="${PROJECT_ROOT}"; \
case "${project_root}" in (/*) ;; (*) printf 'ERROR: workspace discovery requires an absolute project directory: %s\n' "${project_root}" >&2; exit 2 ;; esac; \
project_root="$(cd "${project_root}" && pwd -P)"; \
git_parent="${project_root}"; \
case "${git_parent}" in (/*) ;; (*) printf 'ERROR: Git marker discovery requires an absolute physical directory: %s\n' "${git_parent}" >&2; exit 2 ;; esac; \
while [ "${git_parent}" != / ] && [ ! -e "${git_parent}/.git" ] && [ ! -L "${git_parent}/.git" ]; do \
	next_git_parent="$(dirname "${git_parent}")"; \
	if [ "${next_git_parent}" = "${git_parent}" ]; then printf 'ERROR: Git marker discovery cannot advance from: %s\n' "${git_parent}" >&2; exit 2; fi; \
	git_parent="${next_git_parent}"; \
done; \
if [ -e "${git_parent}/.git" ] || [ -L "${git_parent}/.git" ]; then git -C "${project_root}" rev-parse --resolve-git-dir "${git_parent}/.git" >/dev/null; fi; \
git_root="$(git -C "${project_root}" rev-parse --show-toplevel)"; \
git_root="$(cd "${git_root}" && pwd -P)"; \
case "${project_root}/" in ("${git_root}/"*) ;; (*) printf 'ERROR: physical Git root does not contain this project: %s\n' "${git_root}" >&2; exit 2 ;; esac; \
if [ "${GITHUB_ACTIONS:-}" = "true" ]; then printf '%s\n' "${project_root}"; exit 0; fi; \
superproject="$(git -C "${project_root}" rev-parse --show-superproject-working-tree)"; \
if [ -n "${superproject}" ] && [ -f "${superproject}/pyproject.toml" ]; then \
	cd "${superproject}" && pwd -P; \
	exit 0; \
fi; \
reader_root=; \
parent="$(dirname "${project_root}")"; \
while [ "${parent}" != / ]; do \
	if [ -f "${parent}/pyproject.toml" ]; then reader_root="${parent}"; break; fi; \
	if [ "${parent}" = "${git_root}" ]; then break; fi; \
	parent="$(dirname "${parent}")"; \
done; \
if [ -z "${reader_root}" ]; then printf '%s\n' "${project_root}"; exit 0; fi; \
git_parent="${reader_root}"; \
case "${git_parent}" in (/*) ;; (*) printf 'ERROR: Git marker discovery requires an absolute physical directory: %s\n' "${git_parent}" >&2; exit 2 ;; esac; \
while [ "${git_parent}" != / ] && [ ! -e "${git_parent}/.git" ] && [ ! -L "${git_parent}/.git" ]; do \
	next_git_parent="$(dirname "${git_parent}")"; \
	if [ "${next_git_parent}" = "${git_parent}" ]; then printf 'ERROR: Git marker discovery cannot advance from: %s\n' "${git_parent}" >&2; exit 2; fi; \
	git_parent="${next_git_parent}"; \
done; \
if [ -e "${git_parent}/.git" ] || [ -L "${git_parent}/.git" ]; then git -C "${reader_root}" rev-parse --resolve-git-dir "${git_parent}/.git" >/dev/null; fi; \
if [ ! -e "${git_parent}/.git" ] && [ ! -L "${git_parent}/.git" ]; then printf '%s\n' "${project_root}"; exit 0; fi; \
scope="$(git -C "${reader_root}" rev-parse --show-toplevel)"; \
scope="$(cd "${scope}" && pwd -P)"; \
case "${project_root}/" in ("${scope}/"*) ;; (*) printf 'ERROR: native workspace discovery scope does not contain this project: %s\n' "${scope}" >&2; exit 2 ;; esac; \
if [ -f "${scope}/pyproject.toml" ]; then reader_root="${scope}"; fi; \
unset MISE_SYSTEM_CONFIG_FILE MISE_ENV MISE_ENV_FILE UV_PROJECT UV_PROJECT_ENVIRONMENT UV_WORKING_DIRECTORY UV_NO_CONFIG; \
MISE_CONFIG_DIR="${reader_root}/.mise"; \
MISE_SYSTEM_CONFIG_DIR="${MISE_CONFIG_DIR}"; \
MISE_GLOBAL_CONFIG_FILE="${MISE_CONFIG_DIR}/config.toml"; \
MISE_CEILING_PATHS="$(dirname "${reader_root}")"; \
export MISE_CONFIG_DIR MISE_SYSTEM_CONFIG_DIR MISE_GLOBAL_CONFIG_FILE MISE_CEILING_PATHS; \
reader_mise=mise; \
uv_requested="$("${reader_mise}" -C "${reader_root}" tool "uv" --requested)"; \
uv_binary="$("${reader_mise}" -C "${reader_root}" which "uv" --tool "uv@${uv_requested}")"; \
if [ ! -x "${uv_binary}" ]; then printf 'ERROR: native workspace reader is not provisioned; run make setup\n' >&2; exit 2; fi; \
owner="$("${uv_binary}" workspace dir --project "${project_root}")"; \
case "${owner}" in (/*) ;; (*) printf 'ERROR: native UV workspace owner is not absolute: %s\n' "${owner}" >&2; exit 2 ;; esac; \
owner="$(cd "${owner}" && pwd -P)"; \
case "${owner}/" in ("${scope}/"*) ;; (*) printf 'ERROR: native UV workspace owner leaves its Git scope: %s\n' "${owner}" >&2; exit 2 ;; esac; \
case "${project_root}/" in ("${owner}/"*) ;; (*) printf 'ERROR: native UV workspace owner does not contain this project: %s\n' "${owner}" >&2; exit 2 ;; esac; \
printf '%s\n' "${owner}" )"
watch_file "${PROJECT_ROOT}/pyproject.toml"
watch_file "${RUNTIME_ROOT}/pyproject.toml"

watch_file "${RUNTIME_ROOT}/.flext/uv/local/pyproject.toml"
watch_file "${RUNTIME_ROOT}/.flext/uv/local/uv.lock"

watch_file "${RUNTIME_ROOT}/.flext/uv/standalone/pyproject.toml"
watch_file "${RUNTIME_ROOT}/.flext/uv/standalone/uv.lock"

watch_file "${RUNTIME_ROOT}/.flext/uv/editable/pyproject.toml"
watch_file "${RUNTIME_ROOT}/.flext/uv/editable/uv.lock"

watch_file "${RUNTIME_ROOT}/.mise.toml"
watch_file "${RUNTIME_ROOT}/mise.lock"
git_parent="$(cd "${GIT_DISCOVERY_ROOT}/.." && pwd -P)"
runtime_parent="$(cd "${RUNTIME_ROOT}/.." && pwd -P)"
export GIT_CEILING_DIRECTORIES="${git_parent}"
export MISE_CEILING_PATHS="${runtime_parent}"
# The ceiling stops discovery of enclosing projects' tools. The operator's own
# global Mise configuration stays visible: host tools (gh, bd, gc) are operator
# owned. Provisioning isolation belongs to the Makefile, which exports its own
# runtime-scoped global and system configuration before every lifecycle and
# activation.
# D-VENV: a member inside a workspace uses the workspace environment; a
# standalone checkout or a linked worktree owns its own physical environment
# inside the checkout. The location is law, never configuration: no
# environment is shared with another checkout or lives outside it.
VENV_DIR="${RUNTIME_ROOT}/.venv"
if [[ -L "${VENV_DIR}" ]]; then
  log_error "workspace environment must be physical, not a symlink: ${VENV_DIR}"
  return 1
fi
if [[ -L "${VENV_DIR%/*}" ]]; then
  log_error "workspace environment parent must be physical, not a symlink: ${VENV_DIR%/*}"
  return 1
fi
export PROJECT_ROOT
export PYTHON_KEYRING_BACKEND="keyring.backends.null.Keyring"
export PYTHONUNBUFFERED=1
# End SECTION: repository environment

# === SECTION: mise activation (managed) ===
# Source: native mise activation. Load the declared tools' real paths,
# including the self-managed mise release. Activation never installs tools.
if ! command -v mise >/dev/null 2>&1; then
  log_error "mise is not installed; install it (https://mise.run) and run make setup"
  return 1
fi
mise_environment="$(mise -C "${RUNTIME_ROOT}" env --shell bash)" || return $?
eval "${mise_environment}"
unset mise_environment
# The declared tools lead the PATH: a standalone binary the caller's PATH
# lists earlier (for example a host ~/.local/bin/uv) never shadows the release
# mise.lock pins. Prepending in reverse keeps mise's own precedence order.
# Every active tool now resolves through its real path, so the caller's Mise
# shim directory (mise's documented data-dir default) is redundant here and
# would list each tool twice.
PATH_rm "${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/mise}/shims"
mise_bin_paths_output="$(mise -C "${RUNTIME_ROOT}" bin-paths)" || return $?
mapfile -t mise_bin_paths <<< "${mise_bin_paths_output}"
for ((mise_index = ${#mise_bin_paths[@]} - 1; mise_index >= 0; mise_index--)); do
  PATH_add "${mise_bin_paths[mise_index]}"
done
unset mise_bin_paths mise_index mise_bin_paths_output
# End SECTION: mise activation

# === SECTION: configured paths (managed) ===
# Source: config:environment_path_prepends
# End SECTION: configured paths

# === SECTION: virtual environment (managed) ===
# Source: the physical Git runtime root owns the derived environment.
if [[ -f "${PROJECT_ROOT}/pyproject.toml" && -d "${VENV_DIR}" ]]; then
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    export UV_PROJECT="${RUNTIME_ROOT}/.flext/uv/standalone"
  else
    export UV_PROJECT="${RUNTIME_ROOT}/.flext/uv/local"
  fi
  export UV_PROJECT_ENVIRONMENT="${VENV_DIR}"
  export VIRTUAL_ENV="${VENV_DIR}"
  if [[ "${OS:-}" == "Windows_NT" ]]; then
    PATH_add "${VENV_DIR}/Scripts"
  else
    PATH_add "${VENV_DIR}/bin"
  fi
else
  unset UV_PROJECT
  unset UV_PROJECT_ENVIRONMENT
  unset VIRTUAL_ENV
fi
# End SECTION: virtual environment

