# Generated by `flext-infra codegen conform`.
# === SECTION: header (managed) ===
# Source: template (base/.envrc.j2)
# Free: no
# Canonical direnv activation for one inferred repository environment.
# End SECTION: header

# === SECTION: strict evaluation and watched inputs (managed) ===
# Source: template (direnv stdlib contract)
strict_env
watch_file .mise.toml
watch_file pyproject.toml
# End SECTION: strict evaluation and watched inputs

# === SECTION: repository environment (managed) ===
# Source: computed:nearest-pyproject-via-direnv-find_up + template
PROJECT_ROOT="$(find_up pyproject.toml)"
PROJECT_ROOT="${PROJECT_ROOT%/*}"
VENV_DIR="${PROJECT_ROOT}/.venv"
PROJECT_STATE_ROOT="${PROJECT_ROOT%/*}/.flext-runtime/${PROJECT_ROOT##*/}"
# Scratch never lives inside a versioned tree: the home scratch root mirrors
# the absolute checkout path so a sandbox is never a tracked scope of any
# enclosing repository (workspace or linked worktree).
PROJECT_SCRATCH="${HOME}/tmp/.flext-runtime${PROJECT_ROOT}/scratch"
mkdir -p "${PROJECT_SCRATCH}"
if command -v chattr >/dev/null 2>&1 && [[ "$(stat -f -c %T "${PROJECT_SCRATCH}")" == "btrfs" ]]; then
  chattr +C "${PROJECT_SCRATCH}"
fi
export PROJECT_ROOT
export TMPDIR="${PROJECT_SCRATCH}"
export GOTMPDIR="${PROJECT_SCRATCH}"
export PYTHON_KEYRING_BACKEND="keyring.backends.null.Keyring"
# Bytecode caching is required. The external cache prefix preserves compiled
# modules between commands while Git remains the sole owner of file visibility.
export PYTHONPYCACHEPREFIX="${PROJECT_STATE_ROOT}/pycache"
export PYTHONUNBUFFERED=1
# End SECTION: repository environment

# === SECTION: mise activation (managed) ===
# Source: typed generated Mise storage contract; setup owns installation.
if [[ -v MISE_DATA_DIR ]] && [[ -n "$MISE_DATA_DIR" ]]; then
  MISE_STORAGE_ROOT="$MISE_DATA_DIR"
elif [[ -v XDG_DATA_HOME ]] && [[ -n "${XDG_DATA_HOME}" ]]; then
  MISE_STORAGE_ROOT="${XDG_DATA_HOME}/mise"
elif [[ -v HOME ]] && [[ -n "${HOME}" ]]; then
  MISE_STORAGE_ROOT="${HOME}/.local/share/mise"
else
  log_error "MISE_DATA_DIR, XDG_DATA_HOME, or HOME must identify persistent Mise storage"
  return 1
fi
case "${MISE_STORAGE_ROOT}" in
  /*) ;;
  *) log_error "MISE_DATA_DIR must be absolute"; return 1 ;;
esac
export MISE_DATA_DIR="${MISE_STORAGE_ROOT}"
export MISE_SHIMS_DIR="${MISE_STORAGE_ROOT}/shims"
PATH_add "$MISE_SHIMS_DIR"
# End SECTION: mise activation

# === SECTION: configured paths (managed) ===
# Source: template + config:environment_path_prepends
PATH_add "${PROJECT_ROOT}/bin"
# End SECTION: configured paths

# === SECTION: virtual environment (managed) ===
# Source: computed:nearest-pyproject-root/.venv + template
if [[ -f "${PROJECT_ROOT}/pyproject.toml" && -d "${VENV_DIR}" ]]; then
  export UV_PROJECT_ENVIRONMENT="${VENV_DIR}"
  export VIRTUAL_ENV="${VENV_DIR}"
  PATH_add "${VENV_DIR}/bin"
else
  unset UV_PROJECT_ENVIRONMENT
  unset VIRTUAL_ENV
fi
# End SECTION: virtual environment


# Repository policy permits this capability; the caller's explicit city
# identity selects its runtime. Standalone activation owns no inherited ledger.
if [[ -v AGENTS_GAS_CITY_ROOT ]]; then
# === SECTION: beads watched inputs (managed) ===
# Source: typed BeadsWorkspaceEnvironmentSpec shared by both direnv profiles.
# Environment sources are host-provided and optional: isolated CI must still
# activate while a city-connected host keeps their exports.
source_env_if_exists "$HOME/.config/environment.d/projects/agent-tools.envrc"
# End SECTION: beads watched inputs

# === SECTION: canonical roots (managed) ===
# strict_env does not export DIRENV_DIR; the cwd is already the envrc directory.
checkout_root="$(pwd -P)"
: "${AGENTS_GAS_CITY_ROOT:?AGENTS_GAS_CITY_ROOT must name the canonical Gas City checkout}"
gas_city_root="$(cd "${AGENTS_GAS_CITY_ROOT}" && pwd -P)"
unset GT_ROOT
unset GT_TOWN_ROOT
unset BEADS_DIR
unset BEADS_DOLT_PORT
unset BEADS_DOLT_DATA_DIR
unset BEADS_DOLT_SHARED_SERVER
watch_file "$checkout_root/.beads/metadata.json"
watch_file "$gas_city_root/.gc/runtime/packs/dolt/dolt-state.json"
# End SECTION: canonical roots

# === SECTION: beads dolt server (managed) ===
# Keep this workspace's Beads identity/database while using Gas City's single
# managed Dolt server. Its runtime publication is the only port authority.
export BEADS_DOLT_SERVER_HOST=127.0.0.1
BEADS_DOLT_SERVER_PORT="$(
  jq -er 'if .running == true and (.port | type == "number") and .port > 0 then
    .port
  else
    error("Gas City managed Dolt state is not healthy")
  end' "$gas_city_root/.gc/runtime/packs/dolt/dolt-state.json"
)"
BEADS_DOLT_SERVER_DATABASE="$(
  jq -er 'if .dolt_mode == "server" and (.dolt_database | type == "string") and (.dolt_database | length > 0) then
    .dolt_database
  else
    error("Gas City must register this repository with a server database identity")
  end' "$checkout_root/.beads/metadata.json"
)"
export BEADS_DOLT_SERVER_PORT BEADS_DOLT_SERVER_DATABASE
export BEADS_DOLT_SERVER_MODE=1
export BEADS_DOLT_AUTO_START=0
# End SECTION: beads dolt server

else
unset GT_ROOT
unset GT_TOWN_ROOT
unset BEADS_DIR
unset BEADS_DOLT_PORT
unset BEADS_DOLT_DATA_DIR
unset BEADS_DOLT_SHARED_SERVER
unset BEADS_DOLT_SERVER_HOST BEADS_DOLT_SERVER_PORT
  unset BEADS_DOLT_SERVER_DATABASE BEADS_DOLT_SERVER_MODE
  unset BEADS_DOLT_AUTO_START
fi

# === SECTION: local overrides (managed) ===
# Source: template. Repository-local, tracked overrides load last and win;
# every other runtime value comes from the caller's environment.
source_env_if_exists .envrc.local
# End SECTION: local overrides
