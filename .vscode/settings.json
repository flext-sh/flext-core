    "**/.dolt_dropped_databases": true,
    "**/.doltcfg": true,
    "**/.git": true,
    "**/.hypothesis": true,
    "**/.mimosa": true,
    "**/.mypy_cache": true,
    "**/.omo": true,
    "**/.pylance_cache": true,
    "**/.pyrefly_cache": true,
    "**/.pytest_cache": true,
    "**/.reports": true,
    "**/.ropeproject": true,
    "**/.ruff_cache": true,
    "**/.scope": true,
    "**/.serena": true,
    "**/.sisyphus": true,
    "**/.state": true,
    "**/.superpowers": true,
    "**/.tox": true,
    "**/.trash": true,
    "**/.turbo": true,
    "**/.venv": true,
    "**/.venv.*": true,
    "**/__pycache__": true,
    "**/__pyrefly_virtual__": true,
    "**/_tmp_*": true,
    "**/build": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/protos": true,
    "**/site": true,
    "**/target": true,
    "**/typings": true,
    "**/venv": true
  },
  "files.watcherExclude": {
    "**/*.bak": true,
    "**/*.egg-info/**": true,
    "**/*.orig": true,
    "**/*.rej": true,
    "**/*.swp": true,
    "**/.archive/**": true,
    "**/.beads/**": true,
    "**/.benchmarks/**": true,
    "**/.bkp/**": true,
    "**/.cache/**": true,
    "**/.dolt/**": true,
    "**/.dolt_dropped_databases/**": true,
    "**/.doltcfg/**": true,
    "**/.git/**": true,
    "**/.hypothesis/**": true,
    "**/.mimosa/**": true,
    "**/.mypy_cache/**": true,
    "**/.omo/**": true,
    "**/.pylance_cache/**": true,
    "**/.pyrefly_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.reports/**": true,
    "**/.ropeproject/**": true,
    "**/.ruff_cache/**": true,
    "**/.scope/**": true,
    "**/.serena/**": true,
    "**/.sisyphus/**": true,
    "**/.state/**": true,
    "**/.superpowers/**": true,
    "**/.tox/**": true,
    "**/.trash/**": true,
    "**/.turbo/**": true,
    "**/.venv.*/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/__pyrefly_virtual__/**": true,
    "**/_tmp_*/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/protos/**": true,
    "**/site/**": true,
    "**/target/**": true,
    "**/typings/**": true,
    "**/venv/**": true
  },
  "git.autoRepositoryDetection": "subFolders",
  "git.detectSubmodules": true,
  "git.detectSubmodulesLimit": 100,
  "git.openRepositoryInParentFolders": "always",
  "git.repositoryScanMaxDepth": 2,
  "githubPullRequests.autoRepositoryDetection": true,
  "githubPullRequests.ignoreSubmodules": false,
  "markdownlint.config": {
    "MD001": true,
    "MD003": {
      "style": "atx"
    },
    "MD004": {
      "style": "dash"
    },
    "MD013": {
      "code_block_line_length": 200,
      "heading_line_length": 200,
      "line_length": 88,
      "tables": false
    },
    "MD022": true,
    "MD023": true,
    "MD024": {
      "siblings_only": true
    },
    "MD025": {
      "front-matter-title": "title",
      "level": 1
    },
    "MD029": {
      "style": "one_or_ordered"
    },
    "MD031": true,
    "MD033": {
      "allowed_elements": [
        "br",
        "details",
        "summary",
        "kbd"
      ]
    },
    "MD036": false,
    "MD040": true,
    "MD041": false,
    "MD042": false,
    "MD046": {
      "style": "fenced"
    },
    "MD048": {
      "style": "backtick"
    },
    "MD049": {
      "style": "asterisk"
    },
    "MD050": {
      "style": "asterisk"
    },
    "MD051": false,
    "MD055": {
      "style": "leading_and_trailing"
    },
    "default": true
  },
  "markdownlint.configFile": ".markdownlint.json",
  "markdownlint.lintWorkspaceGlobs": [
    "!**/*.bak",
    "!**/*.egg-info/**",
    "!**/*.orig",
    "!**/*.rej",
    "!**/*.swp",
    "!**/.agents-sync-home/**",
    "!**/.agents/**",
    "!**/.archive/**",
    "!**/.beads/**",
    "!**/.benchmarks/**",
    "!**/.bkp/**",
    "!**/.cache/**",
    "!**/.claude/**",
    "!**/.codex/**",
    "!**/.cursor/**",
    "!**/.gemini/**",
    "!**/.git/**",
    "!**/.hypothesis/**",
    "!**/.kilo/**",
    "!**/.mypy_cache/**",
    "!**/.omo/**",
    "!**/.opencode/**",
    "!**/.pylance_cache/**",
    "!**/.pyrefly_cache/**",
    "!**/.pytest_cache/**",
    "!**/.reports/**",
    "!**/.ruff_cache/**",
    "!**/.serena/**",
    "!**/.snapshots/**",
    "!**/.test-tmp/**",
    "!**/.tmp/**",
    "!**/.tox/**",
    "!**/.venv.*/**",
    "!**/.venv/**",
    "!**/.vscode/**",
    "!**/.worktrees/**",
    "!**/__pycache__/**",
    "!**/__pyrefly_virtual__/**",
    "!**/_tmp_*/**",
    "!**/build/**",
    "!**/dist-packages/**",
    "!**/dist/**",
    "!**/htmlcov/**",
    "!**/incoming/**",
    "!**/legado/**",
    "!**/node_modules/**",
    "!**/reports/**",
    "!**/site-packages/**",
    "!**/site/**",
    "!**/target/**",
    "!**/tests/fixtures/**",
    "!**/venv/**",
    "!.zcode/**",
    "!CHANGELOG.md",
    "!CLAUDE.md",
    "!GEMINI.md",
    "!docs/api-reference/generated/**",
    "!docs/architecture/communities/index.md",
    "!docs/architecture/crg-reports/**",
    "!docs/knowledge-index.md",
    "!docs/plans/2026-09-14-stabilization-handoff/previous-handoff-source.md",
    "!docs/plans/2026-09-22-pipeline-integracao-continua-plano.md",
    "!docs/plans/2026-09-22-rope-generator-stabilization/02-achados-codegen.md",
    "!docs/plans/2026-09-23-handoff-mypy-stabilization-e-integracao.md",
    "!docs/plans/2026-09-25-v8-flext-service-base/05-phases.md",
    "!docs/plans/2026-09-25-v8-flext-service-base/07-sessions-guide.md",
    "!docs/projects/generated/**",
    "!docs/standards/consumption-law.md",
    "**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}"
  ],
  "mypy-type-checker.cwd": "${nearestConfig}",
  "mypy-type-checker.interpreter": [
    "${workspaceFolder}/../.venv/bin/python"
  ],
  "mypy-type-checker.path": [
    "${interpreter}",
    "-m",
    "mypy"
  ],
  "pyrefly.lspPath": "${workspaceFolder}/../.venv/bin/pyrefly",
  "python-envs.workspaceSearchPaths": [
    "./.venv"
  ],
  "python.analysis.addExtraPathsForPythonProjects": false,
  "python.analysis.autoFormatStrings": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.diagnosticsSource": "Pylance + Pyright",
  "python.analysis.displayEnglishDiagnostics": true,
  "python.analysis.enableAsyncProgram": false,
  "python.analysis.enableExternalTypeServer": false,
  "python.analysis.enableParallelIndexing": false,
  "python.analysis.enablePydanticSupport": true,
  "python.analysis.enablePyreflyNotification": false,
  "python.analysis.enablePyreflyNotificationForAll": false,
  "python.analysis.enablePyreflyShadowExperiment": false,
  "python.analysis.enableSnippetExtraTelemetry": false,
  "python.analysis.findRefsInBackgroundThread": false,
  "python.analysis.generateWithTypeAnnotation": true,
  "python.analysis.gotoOverrideCodeLens": true,
  "python.analysis.includeAliasesFromUserFiles": true,
  "python.analysis.includeExtraPathSymbolsInSymbolSearch": true,
  "python.analysis.includeVenvInWorkspaceSymbols": false,
  "python.analysis.indexing": true,
  "python.analysis.inlayHints.callArgumentNames": "all",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.pytestParameters": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.languageServerBackend": "default",
  "python.analysis.languageServerMode": "default",
  "python.analysis.logLevel": "Information",
  "python.analysis.pyrightVersion": "fromEnvironment",
  "python.analysis.referencesCodeLens": true,
  "python.analysis.renameInDocstrings": true,
  "python.analysis.showOnlyDirectDependenciesInAutoImport": false,
  "python.analysis.supportDocstringTemplate": true,
  "python.analysis.useDefaultExcludes": true,
  "python.analysis.useNearestConfiguration": false,
  "python.analysis.usePerProjectEnvironments": false,
  "python.analysis.userFileIndexingLimit": -1,
  "python.defaultInterpreterPath": "${workspaceFolder}/../.venv/bin/python",
  "python.languageServer": "Pylance",
  "python.pyrefly.diagnosticMode": "workspace",
  "python.pyrefly.disableLanguageServices": true,
  "python.pyrefly.disableTypeErrors": false,
  "python.pyrefly.syncNotebooks": false,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,
  "python.useEnvironmentsExtension": true,
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.format.preview": true,
  "ruff.importStrategy": "fromEnvironment",
  "ruff.interpreter": [
    "${workspaceFolder}/../.venv/bin/python"
  ],
  "ruff.lint.preview": true,
  "ruff.path": [
    "${workspaceFolder}/../.venv/bin/ruff"
  ],
